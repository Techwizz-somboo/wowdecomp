<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Frame name="EditorParent" setAllPoints="true" frameStrata="MEDIUM" hidden="true">
		<Frames>
			<Frame name="EditorMenuBar" inherits="NoggitBoxTemplate" enableMouse="true">
				<Size>
					<AbsDimension y="26"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT"/>
					<Anchor point="TOPRIGHT"/>
				</Anchors>
				<Frames>
					<Frame name="EditorWorkspaceTabs">
						<Size>
							<AbsDimension x="10" y="26"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT">
								<Offset>
									<AbsDimension x="-40" y="0"/>
								</Offset>
							</Anchor>
						</Anchors>
					</Frame>
					<Button name="EditorExitButton" inherits="NoggitBoxTemplate">
						<Size>
							<AbsDimension x="35" y="26"/>
						</Size>
						<Anchors>
							<Anchor point="RIGHT"/>
						</Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<Texture file="Interface\GameEditor\Textures\icon_close.tga">
									<Size>
										<AbsDimension x="14" y="14"/>
									</Size>
									<Anchors>
										<Anchor point="CENTER"/>
									</Anchors>
									<TexCoords left="0" right="0.875" top="0" bottom="0.875"/>
								</Texture>
							</Layer>
						</Layers>
						<Scripts>
							<OnEnter>
								NoggitBox_Set(self, NOGGIT_COLOR_MID, nil);
								NoggitTooltip_Show(self, "Leave the game editor ("..(GameEditor_GetToggleKey() or "F12")..")");
							</OnEnter>
							<OnLeave>
								NoggitBox_Set(self, NOGGIT_COLOR_BASE, nil);
								NoggitTooltip_Hide();
							</OnLeave>
							<OnClick>
								GameEditor_SetActive(false);
							</OnClick>
						</Scripts>
					</Button>
				</Frames>
			</Frame>
			<Frame name="EditorStatusBar" inherits="NoggitBoxTemplate" enableMouse="true">
				<Size>
					<AbsDimension y="22"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMLEFT"/>
					<Anchor point="BOTTOMRIGHT"/>
				</Anchors>
			</Frame>
			<Frame name="EditorToolDock" inherits="NoggitBoxTemplate" enableMouse="true">
				<Size>
					<AbsDimension x="265"/>
				</Size>
				<Anchors>
					<Anchor point="TOPRIGHT" relativeTo="EditorMenuBar" relativePoint="BOTTOMRIGHT"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="EditorStatusBar" relativePoint="TOPRIGHT"/>
				</Anchors>
				<Frames>
					<Frame name="EditorToolDockTitle" inherits="NoggitBoxTemplate">
						<Size>
							<AbsDimension y="27"/>
						</Size>
						<Anchors>
							<Anchor point="TOPLEFT"/>
							<Anchor point="TOPRIGHT"/>
						</Anchors>
						<Layers>
							<Layer level="ARTWORK">
								<FontString name="EditorToolDockTitleText" inherits="NoggitFont" justifyH="CENTER">
									<Anchors>
										<Anchor point="LEFT">
											<Offset>
												<AbsDimension x="12" y="0"/>
											</Offset>
										</Anchor>
										<Anchor point="RIGHT">
											<Offset>
												<AbsDimension x="-40" y="0"/>
											</Offset>
										</Anchor>
									</Anchors>
								</FontString>
							</Layer>
						</Layers>
						<Frames>
							<Button name="EditorToolDockClose" inherits="NoggitBoxTemplate">
								<Size>
									<AbsDimension x="35" y="27"/>
								</Size>
								<Anchors>
									<Anchor point="RIGHT"/>
								</Anchors>
								<Layers>
									<Layer level="ARTWORK">
										<Texture file="Interface\GameEditor\Textures\icon_close.tga">
											<Size>
												<AbsDimension x="14" y="14"/>
											</Size>
											<Anchors>
												<Anchor point="CENTER"/>
											</Anchors>
											<TexCoords left="0" right="0.875" top="0" bottom="0.875"/>
										</Texture>
									</Layer>
								</Layers>
								<Scripts>
									<OnEnter>
										NoggitBox_Set(self, NOGGIT_COLOR_MID, nil);
									</OnEnter>
									<OnLeave>
										NoggitBox_Set(self, NOGGIT_COLOR_DARK, nil);
									</OnLeave>
									<OnClick>
										GameEditor_SetToolPanelShown(false);
									</OnClick>
								</Scripts>
							</Button>
						</Frames>
					</Frame>
					<Frame name="EditorToolDockContent">
						<Anchors>
							<Anchor point="TOPLEFT" relativeTo="EditorToolDockTitle" relativePoint="BOTTOMLEFT"/>
							<Anchor point="BOTTOMRIGHT"/>
						</Anchors>
					</Frame>
				</Frames>
			</Frame>
			<Frame name="EditorLeftToolbar" inherits="NoggitBoxTemplate" enableMouse="true">
				<Size>
					<AbsDimension x="44" y="44"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="EditorMenuBar" relativePoint="BOTTOMLEFT">
						<Offset>
							<AbsDimension x="5" y="-5"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="EditorViewToolbar" inherits="NoggitBoxTemplate" enableMouse="true">
				<Size>
					<AbsDimension x="44" y="44"/>
				</Size>
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="EditorLeftToolbar" relativePoint="TOPRIGHT">
						<Offset>
							<AbsDimension x="10" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
			<Frame name="EditorMainArea">
				<Anchors>
					<Anchor point="TOPLEFT" relativeTo="EditorMenuBar" relativePoint="BOTTOMLEFT"/>
					<Anchor point="BOTTOMRIGHT" relativeTo="EditorToolDock" relativePoint="BOTTOMLEFT"/>
				</Anchors>
			</Frame>
			<Frame name="EditorNotifications">
				<Size>
					<AbsDimension x="420" y="10"/>
				</Size>
				<Anchors>
					<Anchor point="TOP" relativeTo="EditorMenuBar" relativePoint="BOTTOM">
						<Offset>
							<AbsDimension x="0" y="-12"/>
						</Offset>
					</Anchor>
				</Anchors>
			</Frame>
		</Frames>
		<Scripts>
			<OnLoad>
				GameEditor_OnLoad(self);
			</OnLoad>
			<OnUpdate>
				GameEditor_OnUpdate(self, elapsed);
			</OnUpdate>
			<OnEvent>
				GameEditor_OnEvent(self, event, ...);
			</OnEvent>
		</Scripts>
	</Frame>
</Ui>
