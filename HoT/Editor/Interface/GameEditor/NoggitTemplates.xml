	</Button>

	<Frame name="NoggitMenuTemplate" inherits="NoggitBoxTemplate" frameStrata="FULLSCREEN_DIALOG" toplevel="true" enableMouse="true" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="200" y="20"/>
		</Size>
	</Frame>

	<Button name="NoggitMenuItemTemplate" virtual="true">
		<Size>
			<AbsDimension x="200" y="22"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBg" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<FontString name="$parentCheck" inherits="NoggitAwesomeFont">
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="8" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentLabel" inherits="NoggitFont" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="28" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<FontString name="$parentShortcut" inherits="NoggitFont" justifyH="RIGHT">
					<Anchors>
						<Anchor point="RIGHT">
							<Offset>
								<AbsDimension x="-12" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnEnter>
				NoggitMenuItem_Refresh(self, true);
			</OnEnter>
			<OnLeave>
				NoggitMenuItem_Refresh(self, false);
			</OnLeave>
			<OnClick>
				NoggitMenuItem_OnClick(self);
			</OnClick>
		</Scripts>
	</Button>

	<Frame name="NoggitTooltipTemplate" inherits="NoggitBoxTemplate" frameStrata="TOOLTIP" hidden="true" virtual="true">
		<Size>
			<AbsDimension x="100" y="22"/>
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentText" inherits="NoggitFont" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="6" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
	</Frame>
	<EditBox name="NoggitLineEditTemplate" inherits="NoggitBoxTemplate" autoFocus="false" letters="128" virtual="true">
		<Size>
			<AbsDimension x="150" y="22"/>
		</Size>
		<TextInsets>
			<AbsInset left="8" right="8" top="0" bottom="0"/>
		</TextInsets>
		<FontString inherits="NoggitFont"/>
		<Scripts>
			<OnLoad>
				NoggitBox_Set(self, NOGGIT_COLOR_DARK, nil);
			</OnLoad>
			<OnEscapePressed>
				self:ClearFocus();
			</OnEscapePressed>
			<OnEnterPressed>
				self:ClearFocus();
			</OnEnterPressed>
		</Scripts>
	</EditBox>

	<Slider name="NoggitVerticalSliderTemplate" orientation="VERTICAL" enableMouse="true" virtual="true">
		<Size>
			<AbsDimension x="35" y="150"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentGroove" setAllPoints="true">
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>
			</Layer>
		</Layers>
		<ThumbTexture name="$parentThumb">
			<Size>
				<AbsDimension x="35" y="5"/>
			</Size>
			<Color r="1" g="0" b="0" a="1"/>
		</ThumbTexture>
		<Scripts>
			<OnLoad>
				self:EnableMouseWheel(true);
				_G[self:GetName().."Groove"]:SetGradient("VERTICAL", 0, 0, 0, 1, 1, 1);
				self.minValue = 0;
				self.maxValue = 255;
				self.step = 1;
			</OnLoad>
			<OnValueChanged>
				if ( not self.updating and self.onChange ) then
					self.onChange(self, value);
				end
			</OnValueChanged>
			<OnMouseWheel>
				self:SetValue(self:GetValue() + delta * (self.step or 1));
			</OnMouseWheel>
		</Scripts>
	</Slider>

	<Button name="NoggitTabButtonTemplate" inherits="NoggitBoxTemplate" virtual="true">
		<Size>
			<AbsDimension x="70" y="24"/>
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIndicator">
					<Size>
						<AbsDimension y="3"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="TOPRIGHT"/>
					</Anchors>
					<Color r="0.322" g="0.506" b="0.725" a="1"/>
				</Texture>
			</Layer>
		</Layers>
		<ButtonText name="$parentText"/>
		<NormalFont style="NoggitFont"/>
		<HighlightFont style="NoggitFont"/>
		<DisabledFont style="NoggitFontDisabled"/>
		<Scripts>
			<OnEnter>
				self.hover = true;
				NoggitTab_Refresh(self);
			</OnEnter>
			<OnLeave>
				self.hover = false;
				NoggitTab_Refresh(self);
			</OnLeave>
		</Scripts>
	</Button>

