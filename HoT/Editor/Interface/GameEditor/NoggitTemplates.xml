<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
	<Frame name="NoggitBoxTemplate" virtual="true">
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBg" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentBorderTop">
					<Size>
						<AbsDimension y="1"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="TOPRIGHT"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="0"/>
				</Texture>
				<Texture name="$parentBorderBottom">
					<Size>
						<AbsDimension y="1"/>
					</Size>
					<Anchors>
						<Anchor point="BOTTOMLEFT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="0"/>
				</Texture>
				<Texture name="$parentBorderLeft">
					<Size>
						<AbsDimension x="1"/>
					</Size>
					<Anchors>
						<Anchor point="TOPLEFT"/>
						<Anchor point="BOTTOMLEFT"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="0"/>
				</Texture>
				<Texture name="$parentBorderRight">
					<Size>
						<AbsDimension x="1"/>
					</Size>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
						<Anchor point="BOTTOMRIGHT"/>
					</Anchors>
					<Color r="0" g="0" b="0" a="0"/>
				</Texture>
			</Layer>
		</Layers>
	</Frame>

	<Button name="NoggitPushButtonTemplate" inherits="NoggitBoxTemplate" virtual="true">
		<Size>
			<AbsDimension x="80" y="23"/>
		</Size>
		<ButtonText name="$parentText"/>
		<NormalFont style="NoggitFont"/>
		<HighlightFont style="NoggitFont"/>
		<DisabledFont style="NoggitFontDisabled"/>
		<Scripts>
			<OnLoad>
				NoggitPushButton_OnLoad(self);
			</OnLoad>
			<OnEnter>
				NoggitButton_SetHover(self, true);
			</OnEnter>
			<OnLeave>
				NoggitButton_SetHover(self, false);
			</OnLeave>
			<OnMouseDown>
				NoggitButton_SetPressed(self, true);
			</OnMouseDown>
			<OnMouseUp>
				NoggitButton_SetPressed(self, false);
			</OnMouseUp>
			<OnEnable>
				NoggitButton_Refresh(self);
			</OnEnable>
			<OnDisable>
				NoggitButton_Refresh(self);
			</OnDisable>
		</Scripts>
	</Button>

	<Button name="NoggitToolButtonTemplate" inherits="NoggitBoxTemplate" virtual="true">
		<Size>
			<AbsDimension x="34" y="34"/>
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentIcon" inherits="NoggitIconFont" setAllPoints="true" justifyH="CENTER" justifyV="MIDDLE"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				NoggitToolButton_OnLoad(self);
			</OnLoad>
			<OnEnter>
				NoggitButton_SetHover(self, true);
				NoggitTooltip_Show(self, self.tooltip);
			</OnEnter>
			<OnLeave>
				NoggitButton_SetHover(self, false);
				NoggitTooltip_Hide();
			</OnLeave>
			<OnMouseDown>
				NoggitButton_SetPressed(self, true);
			</OnMouseDown>
			<OnMouseUp>
				NoggitButton_SetPressed(self, false);
			</OnMouseUp>
			<OnEnable>
				NoggitButton_Refresh(self);
			</OnEnable>
			<OnDisable>
				NoggitButton_Refresh(self);
			</OnDisable>
		</Scripts>
	</Button>

	<Button name="NoggitCheckBoxTemplate" virtual="true">
		<Size>
			<AbsDimension x="110" y="20"/>
		</Size>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentIndicator" file="Interface\GameEditor\Textures\icon_checkbox_unchecked.tga">
					<Size>
						<AbsDimension x="16" y="16"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT"/>
					</Anchors>
					<TexCoords left="0" right="0.75" top="0" bottom="0.75"/>
				</Texture>
				<FontString name="$parentLabel" inherits="NoggitFont" justifyH="LEFT">
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="24" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				NoggitCheckBox_OnLoad(self);
			</OnLoad>
			<OnClick>
				NoggitCheckBox_OnClick(self);
			</OnClick>
			<OnEnter>
				self.hover = true;
				NoggitCheckBox_Refresh(self);
				NoggitTooltip_Show(self, self.tooltip);
			</OnEnter>
			<OnLeave>
				self.hover = false;
				NoggitCheckBox_Refresh(self);
				NoggitTooltip_Hide();
			</OnLeave>
			<OnEnable>
				NoggitCheckBox_Refresh(self);
			</OnEnable>
			<OnDisable>
				NoggitCheckBox_Refresh(self);
			</OnDisable>
		</Scripts>
	</Button>

	<Slider name="NoggitSliderTemplate" orientation="HORIZONTAL" enableMouse="true" virtual="true">
		<Size>
			<AbsDimension x="200" y="16"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentGroove">
					<Size>
						<AbsDimension y="8"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT"/>
						<Anchor point="RIGHT"/>
					</Anchors>
					<Color r="0.176" g="0.184" b="0.204" a="1"/>
				</Texture>
			</Layer>
			<Layer level="BORDER">
				<Texture name="$parentGrooveInner">
					<Size>
						<AbsDimension y="6"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="1" y="0"/>
							</Offset>
						</Anchor>
						<Anchor point="RIGHT">
							<Offset>
								<AbsDimension x="-1" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="0.122" g="0.125" b="0.137" a="1"/>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture name="$parentSubPage">
					<Size>
						<AbsDimension x="1" y="6"/>
					</Size>
					<Anchors>
						<Anchor point="LEFT">
							<Offset>
								<AbsDimension x="1" y="0"/>
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="1" g="1" b="1" a="1"/>
				</Texture>
			</Layer>
		</Layers>
		<ThumbTexture name="$parentThumb">
			<Size>
				<AbsDimension x="9" y="16"/>
			</Size>
			<Color r="0.322" g="0.506" b="0.725" a="1"/>
		</ThumbTexture>
		<Scripts>
			<OnLoad>
				NoggitSlider_OnLoad(self);
			</OnLoad>
			<OnValueChanged>
				NoggitSlider_OnValueChanged(self, value);
			</OnValueChanged>
			<OnSizeChanged>
				NoggitSlider_UpdateFill(self);
			</OnSizeChanged>
			<OnMouseWheel>
				NoggitSlider_OnMouseWheel(self, delta);
			</OnMouseWheel>
		</Scripts>
	</Slider>

	<Frame name="NoggitSpinBoxTemplate" inherits="NoggitBoxTemplate" virtual="true">
		<Size>
			<AbsDimension x="84" y="22"/>
		</Size>
		<Frames>
			<EditBox name="$parentEdit" autoFocus="false" letters="16">
				<Anchors>
					<Anchor point="TOPLEFT">
						<Offset>
							<AbsDimension x="6" y="0"/>
						</Offset>
					</Anchor>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-18" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<FontString inherits="NoggitFont"/>
				<Scripts>
					<OnEnterPressed>
						NoggitSpinBox_Commit(self:GetParent());
						self:ClearFocus();
					</OnEnterPressed>
					<OnEscapePressed>
						NoggitSpinBox_Refresh(self:GetParent());
						self:ClearFocus();
					</OnEscapePressed>
					<OnEditFocusLost>
						NoggitSpinBox_Commit(self:GetParent());
					</OnEditFocusLost>
				</Scripts>
			</EditBox>
			<Button name="$parentUp">
				<Size>
					<AbsDimension x="15" y="11"/>
				</Size>
				<Anchors>
					<Anchor point="TOPRIGHT">
						<Offset>
							<AbsDimension x="-1" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture file="Interface\GameEditor\Textures\spinup.tga">
					<TexCoords left="0" right="0.9375" top="0" bottom="0.6875"/>
				</NormalTexture>
				<PushedTexture file="Interface\GameEditor\Textures\spinup_pressed.tga">
					<TexCoords left="0" right="0.9375" top="0" bottom="0.6875"/>
				</PushedTexture>
				<HighlightTexture file="Interface\GameEditor\Textures\spinup_hover.tga" alphaMode="BLEND">
					<TexCoords left="0" right="0.9375" top="0" bottom="0.6875"/>
				</HighlightTexture>
				<DisabledTexture file="Interface\GameEditor\Textures\spinup_disabled.tga">
					<TexCoords left="0" right="0.9375" top="0" bottom="0.6875"/>
				</DisabledTexture>
				<Layers>
					<Layer level="OVERLAY">
						<Texture file="Interface\GameEditor\Textures\up_arrow.tga">
							<Size>
								<AbsDimension x="8" y="6"/>
							</Size>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
							<TexCoords left="0" right="1" top="0" bottom="0.75"/>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>
						NoggitSpinBox_Step(self:GetParent(), 1);
					</OnClick>
				</Scripts>
			</Button>
			<Button name="$parentDown">
				<Size>
					<AbsDimension x="15" y="11"/>
				</Size>
				<Anchors>
					<Anchor point="BOTTOMRIGHT">
						<Offset>
							<AbsDimension x="-1" y="0"/>
						</Offset>
					</Anchor>
				</Anchors>
				<NormalTexture file="Interface\GameEditor\Textures\spindown.tga">
					<TexCoords left="0" right="0.9375" top="0" bottom="0.6875"/>
				</NormalTexture>
				<PushedTexture file="Interface\GameEditor\Textures\spindown_pressed.tga">
					<TexCoords left="0" right="0.9375" top="0" bottom="0.6875"/>
				</PushedTexture>
				<HighlightTexture file="Interface\GameEditor\Textures\spindown_hover.tga" alphaMode="BLEND">
					<TexCoords left="0" right="0.9375" top="0" bottom="0.6875"/>
				</HighlightTexture>
				<DisabledTexture file="Interface\GameEditor\Textures\spindown_disabled.tga">
					<TexCoords left="0" right="0.9375" top="0" bottom="0.6875"/>
				</DisabledTexture>
				<Layers>
					<Layer level="OVERLAY">
						<Texture file="Interface\GameEditor\Textures\down_arrow.tga">
							<Size>
								<AbsDimension x="8" y="6"/>
							</Size>
							<Anchors>
								<Anchor point="CENTER"/>
							</Anchors>
							<TexCoords left="0" right="1" top="0" bottom="0.75"/>
						</Texture>
					</Layer>
				</Layers>
				<Scripts>
					<OnClick>
						NoggitSpinBox_Step(self:GetParent(), -1);
					</OnClick>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnLoad>
				NoggitSpinBox_OnLoad(self);
			</OnLoad>
			<OnMouseWheel>
				NoggitSpinBox_Step(self, delta);
			</OnMouseWheel>
		</Scripts>
	</Frame>

	<Frame name="NoggitGroupBoxTemplate" inherits="NoggitBoxTemplate" virtual="true">
