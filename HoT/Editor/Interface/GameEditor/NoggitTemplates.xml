							<Offset>
								<AbsDimension x="0" y="-4"/>
							</Offset>
						</Anchor>
					</Anchors>
				</FontString>
				<Texture name="$parentTitleLine">
					<Size>
						<AbsDimension x="10" y="1"/>
					</Size>
					<Anchors>
						<Anchor point="TOP">
							<Offset>
								<AbsDimension x="0" y="-21"/>
							</Offset>
						</Anchor>
					</Anchors>
					<Color r="0.322" g="0.506" b="0.725" a="1"/>
				</Texture>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad>
				NoggitGroupBox_OnLoad(self);
			</OnLoad>
		</Scripts>
	</Frame>

	<Button name="NoggitMenuBarButtonTemplate" virtual="true">
		<Size>
			<AbsDimension x="40" y="19"/>
		</Size>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture name="$parentBg" setAllPoints="true">
					<Color r="0" g="0" b="0" a="0"/>
				</Texture>
			</Layer>
		</Layers>
		<ButtonText name="$parentText"/>
		<NormalFont style="NoggitFont"/>
		<HighlightFont style="NoggitFont"/>
		<Scripts>
